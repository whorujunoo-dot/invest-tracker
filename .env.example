# 기록소 설정값 목록. 실제 값은 Vercel과 GitHub의 비밀 설정에만 넣고, 이 파일이나 채팅에는 절대 적지 않는다.

# Supabase → Connect → Transaction pooler (포트 6543) 주소
DATABASE_URL=
# Supabase → Connect → Session pooler (포트 5432) 주소 — GitHub 백업용
DATABASE_URL_SESSION=

# 텔레그램 BotFather가 준 토큰
TELEGRAM_BOT_TOKEN=
# 아무 긴 무작위 글자 (예: 비밀번호 관리자에서 40자 생성)
TELEGRAM_WEBHOOK_SECRET=
# 내 텔레그램 숫자 ID (@userinfobot 에게 물어보면 알려 줌)
TELEGRAM_OWNER_ID=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=girokso-originals

# AI
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
OPENAI_API_KEY=
TRANSCRIBE_MODEL=gpt-4o-transcribe

# 웹 로그인
APP_PASSWORD=
# 아무 긴 무작위 글자
SESSION_SECRET=
CRON_SECRET=

APP_TIME_ZONE=Asia/Seoul

# ── 아래는 GitHub 비밀 설정에만 ──
APP_URL=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=girokso-backup
RESTIC_REPOSITORY=s3:s3.us-west-004.backblazeb2.com/girokso-backup/restic
# 백업 암호. 잃어버리면 백업을 열 수 없다. 비밀번호 관리자 + 종이 두 곳에 보관
BACKUP_PASSPHRASE=
